{
  "name": "gridiron-physics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Physics-based 22-player reconstruction of a real NFL game from ESPN play-by-play, with a Madden-style rating engine grounded in public research.",
  "scripts": {
    "data": "python3 pipeline/fetch.py && python3 pipeline/ratings.py && python3 pipeline/build_game.py",
    "build": "python3 pipeline/ratings.py && python3 pipeline/build_game.py",
    "test": "node test/validate.mjs --strict && node test/prototype.mjs && python3 test/test_prototype_data.py",
    "serve": "python3 -m http.server 8080 --directory .",
    "eval:physics3d": "node research/physics-3d-evaluation/benchmark.mjs",
    "eval:physics3d:test": "node research/physics-3d-evaluation/test-headless.mjs",
    "eval:physics3d:browser": "node research/physics-3d-evaluation/browser-test.mjs",
    "eval:physics3d:sweep": "node research/physics-3d-evaluation/sweep.mjs",
    "eval:physics3d:sweep:test": "node research/physics-3d-evaluation/test-sweep.mjs",
    "eval:physics3d:contact": "node research/physics-3d-evaluation/contact-mechanism.mjs",
    "eval:physics3d:contact:test": "node research/physics-3d-evaluation/test-contact-mechanism.mjs",
    "eval:physics3d:energy": "node research/physics-3d-evaluation/contact-energy.mjs",
    "eval:physics3d:energy:test": "node research/physics-3d-evaluation/test-contact-energy.mjs",
    "eval:physics3d:energy:horizon": "node research/physics-3d-evaluation/contact-energy-horizon.mjs",
    "eval:physics3d:energy:horizon:test": "node research/physics-3d-evaluation/test-contact-energy-horizon.mjs",
    "eval:physics3d:energy:full-grid": "node research/physics-3d-evaluation/contact-energy-full-grid.mjs",
    "eval:physics3d:energy:full-grid:test": "node research/physics-3d-evaluation/test-contact-energy-full-grid.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "jolt-physics": "1.1.0",
    "playwright": "1.64.1"
  }
}
